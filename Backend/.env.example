PORT=5000
MONGO_URI=
JWT_SECRET=
JWT_EXPIRE=7d
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ImageKit.io
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Email (Gmail App Password or Ethereal)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required for /api/payments/webhook (set in Razorpay Dashboard > Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# Dev only: allow mock payments + webhook simulator. Ignored when NODE_ENV=production.
ALLOW_MOCK_PAYMENTS=true

# AI - Optional
OPENAI_API_KEY=
